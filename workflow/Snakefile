# =============================================================================
# kallisto-TE pipeline: steps 2-4 in one command (guide: docs/06_snakemake.md)
#
#   step 2  trim bulk reads (fastp)        scripts/qc/run_fastp.sh
#   step 3  quantify bulk (kallisto)       scripts/quant/run_kallisto_quant.sh
#   step 4  count single-cell (kb count)   scripts/quant/run_kb_count.sh
#
# The genes + TE index (step 1) is NOT built here: build it once per species
# and genome release with scripts/index/build_index.sh (docs/01_build_index.md)
# and point every project at it, so all your analyses share the same,
# documented reference.
#
# Each rule runs the same script you would run by hand, on a whole folder of
# samples, so results are identical to the step-by-step guides.
#
# Run from the repository folder:
#   snakemake --cores 8 --configfile /path/to/my_project.yaml                  # this computer
#   snakemake --profile profiles/slurm --configfile /path/to/my_project.yaml   # SLURM
# Add -n to see what would run without running it.
# =============================================================================
import glob
import json
import os
import shlex

from snakemake.exceptions import WorkflowError

REPO = os.path.normpath(os.path.join(workflow.basedir, ".."))
SCRIPTS = os.path.join(REPO, "scripts")

configfile: os.path.join(REPO, "config", "config.yaml")


def fail(msg):
    raise WorkflowError("kallisto-TE config: " + msg)


FASTQ_EXTS = (".fastq.gz", ".fq.gz", ".fastq", ".fq")


def list_fastqs(folder, what):
    """FASTQ files directly in folder, or else one level down (one sub-folder
    per sample). Returns (files, in_subfolders)."""
    if not os.path.isdir(folder):
        fail(f"{what}.fastq_dir is not a folder: {folder}")
    top = sorted(f for f in glob.glob(os.path.join(folder, "*")) if f.endswith(FASTQ_EXTS))
    if top:
        return top, False
    sub = sorted(f for f in glob.glob(os.path.join(folder, "*", "*")) if f.endswith(FASTQ_EXTS))
    if not sub:
        fail(f"no FASTQ files (.fastq.gz/.fq.gz/.fastq/.fq) in {what}.fastq_dir: {folder}")
    return sub, True


def settings_check(step_dir, settings):
    """Results are kept between runs, so an interrupted run resumes where it
    stopped. If this step last ran with OTHER settings, redo every sample
    (--force) so results never mix old and new settings."""
    current = json.dumps(settings, sort_keys=True)
    try:
        with open(os.path.join(step_dir, "pipeline_settings.json")) as fh:
            previous = fh.read().strip()
    except OSError:
        return current, ""
    return current, ("--force" if previous != current else "")


def res(step):
    r = config["resources"][step]
    return r["threads"], {"mem_mb": r["mem_mb"], "runtime": r["runtime"]}


OUT = config["outdir"].rstrip("/") or "."
LOGS = f"{OUT}/logs"
targets = []

# ----------------------------------------------------------------------------
# The index from step 1 (required)
# ----------------------------------------------------------------------------
if not config.get("index"):
    fail("set 'index' to the .idx file of a genes + TE index. Build one first, once per "
         "species, with scripts/index/build_index.sh (docs/01_build_index.md)")
if not isinstance(config["index"], str):
    fail("'index' must be the path of an .idx file, e.g. index: /path/to/mm10_genes_TE.idx. "
         "The pipeline does not build indexes: build one with scripts/index/build_index.sh "
         "(docs/01_build_index.md)")
INDEX = os.path.abspath(config["index"])
if not os.path.isfile(INDEX):
    fail(f"index file not found: {config['index']}. Build it first with "
         "scripts/index/build_index.sh (docs/01_build_index.md); it is the .idx file in its index/ folder")
T2G = os.path.abspath(config.get("t2g") or os.path.join(os.path.dirname(INDEX), "t2g.txt"))
if not os.path.isfile(T2G):
    fail(f"t2g.txt not found next to the index ({T2G}); give its path with 't2g'")
# A different or rebuilt index means every sample is quantified again.
INDEX_ID = {"index": INDEX, "modified": os.path.getmtime(INDEX)}

bc, sc = config.get("bulk") or {}, config.get("singlecell") or {}
if not (bc.get("fastq_dir") or sc.get("fastq_dir")):
    fail("nothing to do: set bulk.fastq_dir (bulk RNA-seq) and/or singlecell.fastq_dir "
         "(droplet single-cell RNA-seq)")

# ----------------------------------------------------------------------------
# Steps 2-3: bulk RNA-seq
# ----------------------------------------------------------------------------
if bc.get("fastq_dir"):
    BULK_DIR = os.path.abspath(bc["fastq_dir"])
    bulk_fastqs, bulk_in_subfolders = list_fastqs(BULK_DIR, "bulk")
    trim_settings = {"fastq_dir": BULK_DIR, "single_end": bool(bc.get("single_end")),
                     "fastp_args": bc.get("fastp_args") or ""}

    if bc.get("trim", True):
        if bulk_in_subfolders:
            fail("bulk reads are in one sub-folder per sample, but trimming needs all FASTQ "
                 "files in one folder. Put them in one folder, or set bulk.trim: false")
        TRIM_DIR = f"{OUT}/01_trimmed"
        trim_json, trim_force = settings_check(TRIM_DIR, trim_settings)
        trim_flags = shlex.join((["--single-end"] if bc.get("single_end") else [])
                                + (["--fastp-args", bc["fastp_args"]] if bc.get("fastp_args") else [])
                                + ([trim_force] if trim_force else []))
        _threads, _res = res("trim_bulk")

        rule trim_bulk:
            input: bulk_fastqs
            output: f"{TRIM_DIR}/fastp_summary.tsv"
            log: f"{LOGS}/2_trim_bulk.log"
            threads: _threads
            resources: **_res
            params: indir = BULK_DIR, outdir = TRIM_DIR, flags = trim_flags, settings = trim_json
            shell:
                "bash {SCRIPTS}/qc/run_fastp.sh --input {params.indir:q} --outdir {params.outdir:q} "
                "--threads {threads} {params.flags} > {log:q} 2>&1 "
                "&& printf '%s\\n' {params.settings:q} > {params.outdir:q}/pipeline_settings.json"

        quant_reads, quant_indir = [f"{TRIM_DIR}/fastp_summary.tsv"], f"{TRIM_DIR}/trimmed"
    else:
        quant_reads, quant_indir = bulk_fastqs, BULK_DIR

    QUANT_DIR = f"{OUT}/02_quant"
    quant_settings = {"index": INDEX_ID, "trim": bool(bc.get("trim", True)), "reads": trim_settings,
                      **{k: bc.get(k) for k in ("strand", "fragment_length", "fragment_sd", "bootstraps")}}
    quant_json, quant_force = settings_check(QUANT_DIR, quant_settings)
    quant_flags = shlex.join(["--strand", str(bc.get("strand", "auto")),
                              "-l", str(bc.get("fragment_length", 200)),
                              "-s", str(bc.get("fragment_sd", 20)),
                              "-b", str(bc.get("bootstraps", 30))]
                             + (["--single-end"] if bc.get("single_end") else [])
                             + ([quant_force] if quant_force else []))
    _threads, _res = res("quant_bulk")

    rule quant_bulk:
        input: reads = quant_reads, idx = INDEX
        output: f"{QUANT_DIR}/quant_summary.tsv"
        log: f"{LOGS}/3_quant_bulk.log"
        threads: _threads
        resources: **_res
        params: indir = quant_indir, outdir = QUANT_DIR, flags = quant_flags, settings = quant_json
        shell:
            "bash {SCRIPTS}/quant/run_kallisto_quant.sh --input {params.indir:q} --index {input.idx:q} "
            "--outdir {params.outdir:q} --threads {threads} {params.flags} > {log:q} 2>&1 "
            "&& printf '%s\\n' {params.settings:q} > {params.outdir:q}/pipeline_settings.json"

    targets.append(f"{QUANT_DIR}/quant_summary.tsv")

# ----------------------------------------------------------------------------
# Step 4: single-cell RNA-seq
# ----------------------------------------------------------------------------
if sc.get("fastq_dir"):
    SC_DIR = os.path.abspath(sc["fastq_dir"])
    sc_fastqs, _ = list_fastqs(SC_DIR, "singlecell")
    KB_DIR = f"{OUT}/03_kb_count"
    kb_settings = {"index": INDEX_ID, "fastq_dir": SC_DIR,
                   **{k: sc.get(k) for k in ("tech", "filter", "h5ad")}}
    kb_json, kb_force = settings_check(KB_DIR, kb_settings)
    kb_flags = shlex.join(["--tech", str(sc["tech"]), "--memory", str(sc.get("memory", "16G"))]
                          + (["--filter"] if sc.get("filter") else [])
                          + (["--h5ad"] if sc.get("h5ad") else [])
                          + ([kb_force] if kb_force else []))
    _threads, _res = res("kb_count")

    rule kb_count:
        input: reads = sc_fastqs, idx = INDEX, t2g = T2G
        output: f"{KB_DIR}/kb_count_summary.tsv"
        log: f"{LOGS}/4_kb_count.log"
        threads: _threads
        resources: **_res
        params: indir = SC_DIR, outdir = KB_DIR, flags = kb_flags, settings = kb_json
        shell:
            "bash {SCRIPTS}/quant/run_kb_count.sh --input {params.indir:q} --index {input.idx:q} "
            "--t2g {input.t2g:q} --outdir {params.outdir:q} --threads {threads} {params.flags} > {log:q} 2>&1 "
            "&& printf '%s\\n' {params.settings:q} > {params.outdir:q}/pipeline_settings.json"

    targets.append(f"{KB_DIR}/kb_count_summary.tsv")


rule all:
    default_target: True
    input: targets
